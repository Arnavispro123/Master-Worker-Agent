# ── Jarvis env — copy to .env and fill in. Never commit .env ──
# Free / gateway
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=  (alias for GEMINI_API_KEY)

# Local free (no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Paid
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Behaviour
JARVIS_DEFAULT_PROVIDER=auto
JARVIS_DANGER_AUTOPILOT=0
JARVIS_PORT=8765
# Voice ownership: 1 = backend may play TTS aloud (terminal/headless use),
# 0 = HUD/orb own the speakers (Electron sets this itself — no double voice)
# JARVIS_BACKEND_VOICE=1
# Mic override: device index or name-substring (else system default). Find yours in wake status.
# JARVIS_MIC_DEVICE=
# Voice timing (seconds): settle pause after wake word, max single listen, silence-to-stop
# JARVIS_WAKE_SETTLE_S=1.0
# JARVIS_MAX_HEAR_S=120
# JARVIS_SILENCE_STOP_S=1.5
# TTS voice (edge-tts): British Jarvis by default
# JARVIS_TTS_VOICE=en-GB-RyanNeural
# JARVIS_TTS_RATE=+25%
# JARVIS_TTS_VOLUME=+0%
# JARVIS_TTS_PITCH=+0Hz
